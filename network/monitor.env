# network/monitor.env: what the monitor needs on monitor1. Committed, nothing
# secret. Development needs no env file: every value has a local default in
# server/config.js.

# Where the server listens, on loopback behind nginx. deploy/nginx/monitor.conf
# names the same port: nginx reads no env file. Change it in both places.
PORT=4400

# The site. The passkey checks accept this origin and this relying-party id
# only. The id is the site's own name, so a passkey made here opens nothing
# else, and no other site's passkey opens this one.
WEB_ORIGIN=https://monitor.anocloud.com
RP_ID=monitor.anocloud.com

# Postgres on this server, over the local socket, as the user the unit runs
# as. No password: Postgres lets a local user in under its own name.
PGHOST=/var/run/postgresql
PGDATABASE=monitor
PGUSER=monitor

# The list of validators: the registry file the validators themselves pull,
# read from GitHub main. The monitor keeps no copy of it in this repository.
REGISTRY_URL=https://raw.githubusercontent.com/Anosphere/anosvalidator/main/network/testnet.registry.json

# The three repositories whose newest commit on main the validators' own
# commits are compared with.
VALIDATOR_REPO=https://github.com/Anosphere/anosvalidator.git
DOORMAN_REPO=https://github.com/Anosphere/anosvalidatornode.git
KEYHOLDER_REPO=https://github.com/Anosphere/anoskeyholder.git

# One sweep a minute, ten seconds for each answer.
SWEEP_SECONDS=60
ANSWER_TIMEOUT_SECONDS=10

# How often the registry and the three commits are read from GitHub.
GITHUB_MINUTES=10

# How long a sign-in lasts.
SESSION_DAYS=30

# A doorman's certificate with fewer days left than this is shown as a
# problem. The certificates last 6.7 days and are renewed on day 3.
CERTIFICATE_WARN_DAYS=3

# The validators' own floor, IGNORE_FLOOR_PERCENT in anossoftware's
# network/testnet.env. The screen shows the floor worked out from it, so the
# two files must agree.
IGNORE_FLOOR_PERCENT=51
